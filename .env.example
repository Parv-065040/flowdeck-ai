# Flowdeck AI — environment configuration
# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# ---------- Postgres ----------
POSTGRES_USER=flowdeck
POSTGRES_PASSWORD=change_me_before_anyone_else_clones_this
POSTGRES_DB=flowdeck

# ---------- Reasoning: Groq (primary) + Gemini (secondary fallback) ----------
# Cloud-hosted, no GPU required on either teammate's machine — see PRODUCTION_PLAN.md for why
# we pivoted off local-GPU-primary.
#
# Groq: console.groq.com — free tier, no credit card. Model: openai/gpt-oss-120b
#   (Groq deprecated its Llama models in June 2026 — don't use llama-3.1-8b-instant, it's gone.)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini: aistudio.google.com — free tier, no credit card. Model: gemini-3.6-flash
# (gemini-2.5-flash was retired for new users as of this build — confirmed from Google's own
# API error response during testing, not a guess.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------- Optional 4th tier: local Ollama (off by default) ----------
# Only relevant if you want to demonstrate/document the fully self-hosted path. Not required to
# run the stack — leave OLLAMA_ENABLED=false unless you specifically need this tier.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ---------- Google Calendar (real booking tool) ----------
# 1. Create a project at console.cloud.google.com, enable the Google Calendar API (free).
# 2. Create a service account, download its JSON key.
# 3. Share your Google Calendar with the service account's email (Settings > Share with specific people).
# 4. Paste the ENTIRE downloaded JSON as a single-line string here.
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=primary

# ---------- Agora ----------
# From your Agora Console project (console.agora.io) — this is the same App ID/Certificate
# your team already has from Round 2/3 mentorship setup.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---------- Misc ----------
LOG_LEVEL=info
